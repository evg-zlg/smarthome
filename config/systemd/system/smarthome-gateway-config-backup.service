[Unit]
Description=Back up non-secret smart home gateway configuration
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backup-smarthome-gateway-config
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/smarthome
