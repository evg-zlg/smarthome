server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/smarthome;
    index index.html;

    access_log /var/log/nginx/smarthome-access.log;
    error_log /var/log/nginx/smarthome-error.log warn;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /gateway/healthz {
        access_log off;
        proxy_pass http://127.0.0.1:8080/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /gateway/map {
        access_log off;
        proxy_pass http://127.0.0.1:8080/map;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /gateway/larnitech/scenario {
        proxy_pass http://127.0.0.1:8080/larnitech/scenario;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 1k;
    }

    location = /gateway/vakio/command {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8080/vakio/command;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        client_max_body_size 1k;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
