server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/smarthome;
    index index.html;

    access_log /var/log/nginx/smarthome-access.log;
    error_log /var/log/nginx/smarthome-error.log warn;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
