---
import Layout from '../../../layouts/Layout.astro';import ContactForm from '../../../components/ContactForm.astro';
const scenarios=[['07:00','Утро','Шторы открываются, мягкий свет помогает проснуться.','ph-sun-horizon'],['09:15','Ушли','Одна кнопка выключает свет, воду и ненужные розетки.','ph-door-open'],['18:30','Возвращаетесь','Квартира заранее готовит комфортную температуру.','ph-house-line'],['23:40','Ночь','Свет гаснет, климат переходит в тихий режим.','ph-moon-stars']];
const features=[['ph-lightbulb','Комфорт','Свет, шторы и сценарии собраны в понятные кнопки.'],['ph-thermometer-simple','Климат','Точная температура по комнатам без постоянной настройки.'],['ph-shield-check','Безопасность','Датчики протечки и открытия сразу сообщают о важном.'],['ph-device-mobile','Управление','Панель, выключатели и приложение работают вместе.']];
const faq=[['Что произойдёт, если пропадёт интернет?','Основные сценарии работают локально. Свет, климат и ручное управление остаются доступны.'],['Можно ли расширить решение позже?','Да. Архитектура позволяет добавить мультимедиа, новые комнаты и расширенный климат.'],['Подойдёт ли для готового ремонта?','После аудита предложим проводной или комбинированный вариант с минимальным вмешательством.']];
---
<Layout title="Люкс для 2-комнатной квартиры — evoHome" description="Готовое решение умного дома для двухкомнатной квартиры."><section class="hero detail-hero"><img src="/media/images/lux-hero.png" alt="Современная гостиная с умным освещением"/><div class="hero-shade"></div><div class="hero-content shell"><a class="crumb" href="/solutions/"><i class="ph ph-arrow-left"></i> Готовые решения</a><p class="eyebrow">evoHome · решение «Люкс»</p><h1>Люкс для<br/>2-комнатной</h1><p class="hero-lead">Свет, климат и шторы подстраиваются под ваш ритм, а дом остаётся под контролем.</p><div class="hero-actions"><a class="button button-light" href="/contacts/">Получить расчёт <i class="ph ph-arrow-right"></i></a><a class="text-link" href="#how">Посмотреть сценарии <i class="ph ph-arrow-down"></i></a></div></div><div class="hero-meta"><span>2 комнаты</span><span>45–80 м²</span><span>локально</span></div></section>
<section class="plan-section shell" id="how"><div class="section-heading"><p class="eyebrow">Сценарий вместо набора устройств</p><h2>Как это работает<br/><em>каждый день</em></h2><p>Технологии остаются в фоне. На первом плане — простые действия и спокойствие за квартиру.</p></div><div class="plan-stage"><img src="/media/images/lux-apartment-plan.png" alt="Схема квартиры с зонами автоматизации"/>{[1,2,3,4].map(n=><button class:list={['hotspot',`hotspot-${n}`,{active:n===1}]} data-point={n}><span>{n}</span></button>)}<div class="plan-note" data-note><small>Сценарий 01</small><strong>Уходя, нажмите одну кнопку</strong><p>Дом сам выключит свет, перекроет воду и включит охрану.</p></div></div><div class="scenario-list">{['Уход из дома','Атмосфера света','Климат заранее','Защита от воды'].map((x,i)=><button class:list={{active:i===0}} data-point={i+1}><span>0{i+1}</span> {x}</button>)}</div></section>
<section class="day-section"><div class="shell"><div class="section-heading compact"><p class="eyebrow">Один день с evoHome</p><h2>Дом подстраивается.<br/>Вы просто <em>живёте.</em></h2></div><div class="day-grid">{scenarios.map(([time,label,text,icon])=><article class="day-card"><div class="day-top"><span>{time}</span><i class={`ph ${icon}`}></i></div><h3>{label}</h3><p>{text}</p></article>)}</div></div></section>
<section class="features shell"><div class="section-heading split"><div><p class="eyebrow">В составе решения</p><h2>Всё нужное.<br/><em>Без лишнего.</em></h2></div><p>Точный состав уточняется после проекта и проверки инженерных систем.</p></div><div class="feature-grid">{features.map(([icon,title,text],i)=><article class={`feature-card feature-${i+1}`}><i class={`ph ${icon}`}></i><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="upgrade shell"><div class="upgrade-copy"><p class="eyebrow">Больше возможностей</p><h2>Готовы к большему?</h2><p>Premium добавляет мультимедиа, качество воздуха и персональные сценарии.</p><a class="button button-light" href="/solutions/">Сравнить решения <i class="ph ph-arrow-right"></i></a></div><div class="upgrade-visual"><img src="/media/images/evohome-eva.png" alt="Визуальный образ evoHome"/><span>evoHome <b>Premium</b></span></div></section>
<section class="faq shell"><div class="section-heading compact"><p class="eyebrow">Коротко о важном</p><h2>Частые вопросы</h2></div><div class="faq-list">{faq.map(([q,a],i)=><details open={i===0}><summary><span>{q}</span><i class="ph ph-plus"></i></summary><p>{a}</p></details>)}</div></section>
<section class="contact"><div class="shell contact-grid"><div><p class="eyebrow">Следующий шаг</p><h2>Расскажите<br/>о квартире</h2><p>Обсудим задачи и подготовим понятный состав решения.</p></div><ContactForm/></div></section></Layout>
<script>
const copy={1:['Сценарий 01','Уходя, нажмите одну кнопку','Дом сам выключит свет, перекроет воду и включит охрану.'],2:['Сценарий 02','Свет создаёт нужную атмосферу','Одно касание включает готовую сцену для ужина или отдыха.'],3:['Сценарий 03','Климат готовит комнаты заранее','Температура меняется по расписанию и учитывает ваш ритм.'],4:['Сценарий 04','Вода перекрывается при протечке','Датчик замечает аварию, а вам приходит уведомление.']};document.querySelectorAll('[data-point]').forEach(el=>el.addEventListener('click',()=>{document.querySelectorAll('[data-point]').forEach(x=>x.classList.toggle('active',x.dataset.point===el.dataset.point));const n=document.querySelector('[data-note]'),c=copy[el.dataset.point];n.querySelector('small').textContent=c[0];n.querySelector('strong').textContent=c[1];n.querySelector('p').textContent=c[2]}));document.querySelectorAll('details').forEach(d=>d.addEventListener('toggle',()=>d.querySelector('i').className=d.open?'ph ph-minus':'ph ph-plus'));
</script>
