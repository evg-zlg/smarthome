---
import Layout from '../../layouts/Layout.astro';
const tiers=[{name:'Базовая',text:'Комфортная и безопасная повседневность',list:['Свет и отопление','Тёплые полы','Защита от протечек']},{name:'Люкс',text:'Больше сценариев без ручной рутины',list:['Диммирование света','Моторизованные шторы','Управление кондиционерами'],featured:true},{name:'Premium',text:'Единая архитектура комфорта',list:['Качество воздуха','Мультимедиа и домофон','Персональные панели']}];
---
<Layout lightHeader title="Готовые решения — evoHome" description="Готовые решения evoHome для квартир и загородных домов."><section class="page-hero shell"><p class="eyebrow">Готовые решения</p><h1>Выберите основу.<br/><em>Мы адаптируем её.</em></h1><p>Понятная отправная точка для квартиры или дома. Точный состав уточняем после проекта.</p></section><section class="object-switch shell" aria-label="Тип объекта"><button class="active" aria-pressed="true">Квартира</button><button disabled>Загородный дом <small>скоро</small></button><button disabled>Управляющая компания <small>скоро</small></button></section><section class="catalog shell"><div class="catalog-head"><div><span>Размер объекта</span><h2>2-комнатная квартира</h2></div><div class="size-pills" aria-label="Размер квартиры"><button disabled>1 комната <small>скоро</small></button><button class="active" aria-pressed="true">2 комнаты</button><button disabled>3 комнаты <small>скоро</small></button></div></div><div class="tier-grid">{tiers.map((tier,i)=><article class:list={['tier-card',{featured:tier.featured}]}><span>0{i+1}</span><p class="eyebrow">Уровень</p><h3>{tier.name}</h3><p>{tier.text}</p><ul>{tier.list.map(x=><li><i class="ph ph-check"></i>{x}</li>)}</ul>{tier.featured?<a href="/solutions/lux-2-room/">Смотреть решение <i class="ph ph-arrow-right"></i></a>:<a href="/contacts/">Уточнить состав <i class="ph ph-arrow-right"></i></a>}</article>)}</div></section><section class="catalog-note shell"><i class="ph ph-info"></i><div><h3>Итоговый состав зависит от объекта</h3><p>Проверяем электрику, инженерные системы, стадию ремонта и привычные сценарии. Не добавляем оборудование без понятной пользы.</p></div><a class="button button-dark" href="/contacts/">Подобрать решение</a></section></Layout>
