---
import '@phosphor-icons/web/regular';
import '../styles/global.css';

const scenarios = [
  { time: '07:00', label: 'Утро', text: 'Шторы открываются, мягкий свет помогает проснуться, ванная уже тёплая.', icon: 'ph-sun-horizon' },
  { time: '09:15', label: 'Ушли', text: 'Одна кнопка выключает свет, воду и ненужные розетки. Охрана включена.', icon: 'ph-door-open' },
  { time: '18:30', label: 'Возвращаетесь', text: 'Квартира заранее готовит комфортную температуру и свет для вечера.', icon: 'ph-house-line' },
  { time: '23:40', label: 'Ночь', text: 'Свет гаснет по сценарию, климат переходит в тихий режим, дом остаётся под защитой.', icon: 'ph-moon-stars' },
];

const features = [
  { icon: 'ph-lightbulb', title: 'Комфорт', text: 'Свет, шторы и сценарии собраны в понятные кнопки для обычной жизни.' },
  { icon: 'ph-thermometer-simple', title: 'Климат', text: 'Точная температура по комнатам без постоянной ручной настройки.' },
  { icon: 'ph-shield-check', title: 'Безопасность', text: 'Датчики протечки, движения и открытия сразу сообщают о важном.' },
  { icon: 'ph-device-mobile', title: 'Управление', text: 'Настенная панель, привычные выключатели и приложение работают вместе.' },
];

const faq = [
  ['Что произойдёт, если пропадёт интернет?', 'Основные сценарии работают локально. Свет, климат и защита от протечек сохраняют ручное управление даже без облака.'],
  ['Можно ли начать с этого решения и расширить его позже?', 'Да. Закладываем архитектуру так, чтобы добавить мультимедиа, новые комнаты, охрану или расширенный климат без переделки основы.'],
  ['Подойдёт ли решение для уже готового ремонта?', 'Зависит от электрики и состава задач. После короткого аудита предложим проводной или комбинированный вариант с минимальным вмешательством.'],
  ['Сколько занимает проектирование?', 'Предварительную схему готовим после интервью и плана квартиры. Точный срок зависит от площади, инженерных систем и стадии ремонта.'],
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="evoHome — готовое решение умного дома для двухкомнатной квартиры." />
    <title>Люкс для 2-комнатной квартиры — evoHome</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="evoHome — на главную">evo<span>Home</span></a>
      <nav aria-label="Основная навигация">
        <a href="#how">Как работает</a>
        <a href="#inside">Что входит</a>
        <a href="#media">Видео</a>
        <a href="#faq">Вопросы</a>
      </nav>
      <a class="header-contact" href="#contact">Обсудить проект <i class="ph ph-arrow-up-right"></i></a>
      <button class="menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false"><i class="ph ph-list"></i></button>
    </header>

    <main id="top">
      <section class="hero">
        <img src="/media/images/lux-hero.png" alt="Современная гостиная с умным освещением" />
        <div class="hero-shade"></div>
        <div class="hero-content shell">
          <a class="crumb" href="#inside"><i class="ph ph-arrow-left"></i> Готовые решения</a>
          <p class="eyebrow">evoHome · решение «Люкс»</p>
          <h1>Дом понимает<br />ваш ритм</h1>
          <p class="hero-lead">Умный дом для двухкомнатной квартиры: комфорт, климат и безопасность без лишней сложности.</p>
          <div class="hero-actions">
            <a class="button button-light" href="#contact">Получить расчёт <i class="ph ph-arrow-right"></i></a>
            <a class="text-link" href="#how">Посмотреть сценарии <i class="ph ph-arrow-down"></i></a>
          </div>
        </div>
        <div class="hero-meta">
          <span>2 комнаты</span><span>от 45 до 80 м²</span><span>локальное управление</span>
        </div>
      </section>

      <section class="plan-section shell" id="how">
        <div class="section-heading">
          <p class="eyebrow">Сценарий вместо набора устройств</p>
          <h2>Как это работает<br /><em>каждый день</em></h2>
          <p>Технологии остаются в фоне. На первом плане — простые действия и спокойствие за квартиру.</p>
        </div>
        <div class="plan-stage">
          <img src="/media/images/lux-apartment-plan.png" alt="Схема двухкомнатной квартиры с зонами автоматизации" />
          <button class="hotspot hotspot-1 active" data-point="1" aria-label="Уход из дома"><span>1</span></button>
          <button class="hotspot hotspot-2" data-point="2" aria-label="Сценарии света"><span>2</span></button>
          <button class="hotspot hotspot-3" data-point="3" aria-label="Управление климатом"><span>3</span></button>
          <button class="hotspot hotspot-4" data-point="4" aria-label="Защита от протечек"><span>4</span></button>
          <div class="plan-note" data-note>
            <small>Сценарий 01</small>
            <strong>Уходя, нажмите одну кнопку</strong>
            <p>Дом сам выключит свет, перекроет воду и включит охрану.</p>
          </div>
        </div>
        <div class="scenario-list" aria-label="Сценарии на схеме">
          <button class="active" data-point="1"><span>01</span> Уход из дома</button>
          <button data-point="2"><span>02</span> Атмосфера света</button>
          <button data-point="3"><span>03</span> Климат заранее</button>
          <button data-point="4"><span>04</span> Защита от воды</button>
        </div>
      </section>

      <section class="day-section">
        <div class="shell">
          <div class="section-heading compact">
            <p class="eyebrow">Один день с evoHome</p>
            <h2>Дом подстраивается.<br />Вы просто <em>живёте.</em></h2>
          </div>
          <div class="day-grid">
            {scenarios.map((item) => (
              <article class="day-card">
                <div class="day-top"><span>{item.time}</span><i class={`ph ${item.icon}`}></i></div>
                <h3>{item.label}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="features shell" id="inside">
        <div class="section-heading split">
          <div><p class="eyebrow">В составе решения</p><h2>Всё нужное.<br /><em>Без лишнего.</em></h2></div>
          <p>Проектируем систему вокруг вашего образа жизни, а не вокруг каталога оборудования.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature, index) => (
            <article class={`feature-card feature-${index + 1}`}>
              <i class={`ph ${feature.icon}`}></i>
              <span>0{index + 1}</span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="upgrade shell">
        <div class="upgrade-copy">
          <p class="eyebrow">Больше возможностей</p>
          <h2>Готовы к большему?</h2>
          <p>Решение Premium добавляет мультимедиа, сложные климатические зоны и ещё больше персональных сценариев.</p>
          <a class="button button-light" href="#contact">Сравнить решения <i class="ph ph-arrow-right"></i></a>
        </div>
        <div class="upgrade-visual">
          <img src="/media/images/evohome-eva.png" alt="Визуальный образ evoHome" />
          <span>evoHome <b>Premium</b></span>
        </div>
      </section>

      <section class="media shell" id="media">
        <div class="section-heading split">
          <div><p class="eyebrow">Система в работе</p><h2>Посмотрите,<br />как это <em>выглядит.</em></h2></div>
          <p>Здесь появятся реальные ролики с объектов evoHome. Файлы хранятся локально и не зависят от Telegram.</p>
        </div>
        <div class="media-grid">
          <article class="media-placeholder"><i class="ph ph-play"></i><span>Экосистема умного дома</span><small>Добавьте office-ecosystem.mp4</small></article>
          <article class="media-placeholder"><i class="ph ph-play"></i><span>Идеальный климат</span><small>Добавьте ideal-climate.mp4</small></article>
          <article class="media-placeholder"><i class="ph ph-play"></i><span>Автоматические ворота</span><small>Добавьте automatic-gates.mp4</small></article>
        </div>
      </section>

      <section class="faq shell" id="faq">
        <div class="section-heading compact"><p class="eyebrow">Коротко о важном</p><h2>Частые вопросы</h2></div>
        <div class="faq-list">
          {faq.map(([question, answer], index) => (
            <details open={index === 0}>
              <summary><span>{question}</span><i class="ph ph-plus"></i></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="shell contact-grid">
          <div>
            <p class="eyebrow">Следующий шаг</p>
            <h2>Расскажите<br />о своей квартире</h2>
            <p>Обсудим задачи, стадию ремонта и подготовим понятный состав решения.</p>
          </div>
          <form id="lead-form">
            <label>Как к вам обращаться?<input name="name" autocomplete="name" required placeholder="Имя" /></label>
            <label>Телефон или Telegram<input name="contact" required placeholder="+7 900 000-00-00" /></label>
            <label>Площадь квартиры<input name="area" inputmode="numeric" placeholder="Например, 68 м²" /></label>
            <button class="button button-dark" type="submit">Обсудить проект <i class="ph ph-arrow-right"></i></button>
            <p class="form-status" role="status"></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <a class="brand dark" href="#top">evo<span>Home</span></a>
      <p>Инженерные системы, которые заботятся о человеке.</p>
      <span>© 2026 evoHome</span>
    </footer>

    <script>
      const copy = {
        1: ['Сценарий 01', 'Уходя, нажмите одну кнопку', 'Дом сам выключит свет, перекроет воду и включит охрану.'],
        2: ['Сценарий 02', 'Свет создаёт нужную атмосферу', 'Одно касание включает готовую сцену для ужина, отдыха или гостей.'],
        3: ['Сценарий 03', 'Климат готовит комнаты заранее', 'Температура меняется по расписанию и учитывает ваш обычный ритм.'],
        4: ['Сценарий 04', 'Вода перекрывается при протечке', 'Датчик замечает аварию, клапан закрывается, а вам приходит уведомление.'],
      };
      const setPoint = (point) => {
        document.querySelectorAll('[data-point]').forEach((el) => el.classList.toggle('active', el.dataset.point === point));
        const note = document.querySelector('[data-note]');
        const [small, strong, text] = copy[point];
        note.querySelector('small').textContent = small;
        note.querySelector('strong').textContent = strong;
        note.querySelector('p').textContent = text;
      };
      document.querySelectorAll('[data-point]').forEach((el) => el.addEventListener('click', () => setPoint(el.dataset.point)));

      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('nav');
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav.classList.toggle('open', !open);
      });
      nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }));

      document.querySelectorAll('details').forEach((detail) => detail.addEventListener('toggle', () => {
        detail.querySelector('i').className = detail.open ? 'ph ph-minus' : 'ph ph-plus';
      }));

      document.querySelector('#lead-form').addEventListener('submit', (event) => {
        event.preventDefault();
        event.currentTarget.querySelector('.form-status').textContent = 'Спасибо! Форма работает локально — подключим отправку после выбора CRM.';
        event.currentTarget.reset();
      });
    </script>
  </body>
</html>
